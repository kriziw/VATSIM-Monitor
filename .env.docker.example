IMAGE_NAMESPACE=kriziw
APP_VERSION=latest
MARIADB_VERSION=11.8
TZ=UTC
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=vatsim_monitor
MYSQL_USER=vatsim_monitor
MYSQL_PASSWORD=vatsim_monitor
MYSQL_PORT=3306
SERVER_PORT=8080
WEB_PORT=3000
TRUST_PROXY=false
ORIGIN=http://localhost:3000
PROTOCOL_HEADER=
HOST_HEADER=
PORT_HEADER=
